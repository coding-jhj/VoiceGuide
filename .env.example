# VoiceGuide server environment example.
# Copy to .env for local development. Do not commit real secrets.

# FastAPI server port for local runs. Cloud Run injects PORT automatically.
PORT=8000

# Optional API protection. Leave empty for local demos; set in production.
API_KEY=

# Optional PostgreSQL/Supabase URL. Leave empty to use local SQLite.
DATABASE_URL=

# Detection event persistence tuning.
# Android performs YOLO inference and sends compact JSON to the server.
DETECT_SAVE_EVERY_N_FRAMES=5
SNAPSHOT_MIN_INTERVAL_S=1.0

# Async DB writer tuning.
DETECTION_EVENT_QUEUE_MAX=512
DETECTION_EVENT_BATCH_SIZE=24
DETECTION_EVENT_FLUSH_INTERVAL_S=0.25


# KAKAO API KEY
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here