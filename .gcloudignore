# Files excluded from `gcloud run deploy --source .`.
# The Cloud Run server does not need Android builds, TFLite assets, training
# data, model-export tools, tests, or project documentation.

.git/
.gitignore
.env
.env.*
!.env.example

__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

android/
train/
tools/
tests/
docs/
data/*
!data/processed/
!data/processed/voiceguide_scenario/
!data/processed/voiceguide_scenario/**
models/
datasets/
runs/
flagged/
__tts_cache__/

*.pt
*.pth
*.onnx
*.onnx.data
*.tflite
voiceguide.db

.idea/
.vscode/
.DS_Store
