# Files excluded from `gcloud run deploy --source .`.
# The Cloud Run server does not need Android builds, TFLite assets, training
# data, model-export tools, tests, or project documentation.

.git/
.gitignore
.env
.env.*
!.env.example

__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
dist/
build/

android/
train/
remotion-video/
tools/
tests/
docs/
data/
models/
datasets/*
!datasets/pedestrian_hotspots/
!datasets/pedestrian_hotspots/**
!datasets/disabled_population/
!datasets/disabled_population/**
!datasets/disabled_gender_degree/
!datasets/disabled_gender_degree/**
runs/
outputs/
tmp/
perf_report/
.claude/
.ruff_cache/
flagged/
__tts_cache__/
perf_log.txt

*.pt
*.pth
*.onnx
*.onnx.data
*.tflite
voiceguide.db

.idea/
.vscode/
.DS_Store
